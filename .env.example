export OPENCODE_API_KEY="your-opencode-zen-key"
export LLM_MODEL="gpt-5.4-mini"
# Switch to the stronger model when needed:
# export LLM_MODEL="gpt-5.4"
# Comma-separated backup models, tried in order if LLM_MODEL fails
# (e.g. during a provider outage). Leave empty to disable failover.
export LLM_MODEL_FALLBACKS="claude-haiku-4-5,kimi-k2.5"

# Optional: YouTube channel URL. Can also be passed via --channel-url.
# export CHANNEL_URL="https://www.youtube.com/@<handle>/videos"
# Optional: free-form context about the channel, injected into the LLM prompt as a
# "Channel context" block. Update this in your .env to reflect the actual channel.
# Multi-line templates work via \n inside double quotes.
# Leave unset for a generic, domain-agnostic prompt.

# export CHANNEL_CONTEXT="A channel about home cooking.\nAudience: home cooks.\nTone: friendly and practical."